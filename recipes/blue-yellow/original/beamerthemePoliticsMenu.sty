% beamerthemePoliticsMenu.sty
% Politics on the Menu -- Yellow / Blue / White Beamer theme
% Compile with pdfLaTeX, LuaLaTeX, or XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemePoliticsMenu}[2026/10/03 v2.0 Politics on the Menu theme]

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{calc}
\usetikzlibrary{calc,positioning}

% -----------------------------------------------------------------------------
% Options
% -----------------------------------------------------------------------------
\newif\ifPMsectionpages
\PMsectionpagestrue
\DeclareOption{sectionpages}{\PMsectionpagestrue}
\DeclareOption{nosectionpages}{\PMsectionpagesfalse}
\ProcessOptions\relax

% -----------------------------------------------------------------------------
% Palette: muted Yellow / Blue / White
% -----------------------------------------------------------------------------
\definecolor{PMNavy}{HTML}{0A3555}
\definecolor{PMNavyDeep}{HTML}{062B47}
\definecolor{PMBlue}{HTML}{2F6689}
\definecolor{PMBlueMid}{HTML}{7899B0}
\definecolor{PMBluePale}{HTML}{EAF1F5}
\definecolor{PMYellow}{HTML}{E5B51B}
\definecolor{PMYellowSoft}{HTML}{F6E8B8}
\definecolor{PMYellowPale}{HTML}{FBF5DF}
\definecolor{PMInk}{HTML}{0B3150}
\definecolor{PMGray}{HTML}{6D7E89}
\definecolor{PMFooter}{HTML}{E7EFF4}
\definecolor{PMWhite}{HTML}{FFFFFF}

% -----------------------------------------------------------------------------
% Typography
% -----------------------------------------------------------------------------
\usefonttheme{professionalfonts}
\IfFileExists{newtxtext.sty}{%
  \RequirePackage{newtxtext}
  \RequirePackage{newtxmath}
}{%
  \IfFileExists{mathpazo.sty}{\RequirePackage{mathpazo}}{}
}

\setbeamerfont{normal text}{family=\rmfamily,size=\normalsize}
\setbeamerfont{title}{family=\rmfamily,series=\bfseries,size=\fontsize{26}{29}}
\setbeamerfont{subtitle}{family=\rmfamily,series=\bfseries,size=\fontsize{17}{20}}
\setbeamerfont{author}{family=\rmfamily,series=\bfseries,size=\fontsize{13.5}{15}}
\setbeamerfont{institute}{family=\rmfamily,size=\fontsize{11.5}{13}}
\setbeamerfont{date}{family=\rmfamily,size=\fontsize{11}{13}}
\setbeamerfont{frametitle}{family=\rmfamily,series=\bfseries,size=\fontsize{15.8}{18.0}}
\setbeamerfont{framesubtitle}{family=\rmfamily,size=\small}
\setbeamerfont{section title}{family=\rmfamily,series=\bfseries,size=\fontsize{31}{34}}
\setbeamerfont{headline}{family=\rmfamily,size=\fontsize{7.7}{9}}
\setbeamerfont{footline}{family=\rmfamily,size=\fontsize{7.4}{8.5}}
\setbeamerfont{section in head/foot}{family=\rmfamily,size=\fontsize{7.6}{9}}
\setbeamerfont{section in head/foot shaded}{family=\rmfamily,size=\fontsize{7.6}{9}}
\setbeamerfont{block title}{family=\rmfamily,series=\bfseries,size=\normalsize}
\setbeamerfont{block body}{family=\rmfamily,size=\small}

% -----------------------------------------------------------------------------
% Beamer colors
% -----------------------------------------------------------------------------
\setbeamercolor{normal text}{fg=PMInk,bg=PMWhite}
\setbeamercolor{structure}{fg=PMYellow}
\setbeamercolor{title}{fg=PMNavyDeep,bg=PMWhite}
\setbeamercolor{subtitle}{fg=PMNavyDeep,bg=PMWhite}
\setbeamercolor{author}{fg=PMNavyDeep,bg=PMWhite}
\setbeamercolor{institute}{fg=PMNavyDeep,bg=PMWhite}
\setbeamercolor{date}{fg=PMNavyDeep,bg=PMWhite}
\setbeamercolor{frametitle}{fg=PMNavyDeep,bg=PMWhite}
\setbeamercolor{headline}{fg=PMWhite,bg=PMNavy}
\setbeamercolor{footline}{fg=PMNavyDeep,bg=PMFooter}
\setbeamercolor{section in head/foot}{fg=PMYellow,bg=PMNavy}
\setbeamercolor{section in head/foot shaded}{fg=PMBluePale,bg=PMNavy}
\setbeamercolor{block title}{fg=PMNavyDeep,bg=PMYellowPale}
\setbeamercolor{block body}{fg=PMInk,bg=PMWhite}
\setbeamercolor{alerted text}{fg=PMYellow}
\setbeamercolor{itemize item}{fg=PMYellow}
\setbeamercolor{itemize subitem}{fg=PMBlue}
\setbeamercolor{enumerate item}{fg=PMNavyDeep,bg=PMYellow}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{bibliography item}[text]

% Slightly more breathing room than stock Beamer.
\setbeamersize{text margin left=.55cm,text margin right=.55cm}

% -----------------------------------------------------------------------------
% Metadata helpers
% -----------------------------------------------------------------------------
\newcommand{\PM@seminar}{Economics Research Seminar}
\newcommand{\PMseminar}[1]{\renewcommand{\PM@seminar}{#1}}
\newcommand{\PM@topright}{}
\newcommand{\PMtopright}[1]{\renewcommand{\PM@topright}{#1}}
\newcommand{\PM@leftfooter}{\insertshortinstitute}
\newcommand{\PMleftfooter}[1]{\renewcommand{\PM@leftfooter}{#1}}
\newcommand{\PM@centerfooter}{\insertshorttitle}
\newcommand{\PMcenterfooter}[1]{\renewcommand{\PM@centerfooter}{#1}}
\newcommand{\PM@assets}{assets/}
\newcommand{\PMassetpath}[1]{\renewcommand{\PM@assets}{#1}}
\newcommand{\PM@sectiontagline}{POLITICAL IDENTITY MEETS EVERYDAY CONSUMPTION}
\newcommand{\PMsectiontagline}[1]{\renewcommand{\PM@sectiontagline}{#1}}

% -----------------------------------------------------------------------------
% Headline / navigation
% -----------------------------------------------------------------------------
\makeatletter
\setbeamertemplate{section in head/foot}{%
  \begin{tikzpicture}[baseline=(t.base)]
    \node[inner sep=0pt,outer sep=0pt,text=PMYellow,font=\usebeamerfont{section in head/foot}] (t)
      {\insertsectionheadnumber.\,\insertsectionhead};
    \draw[PMYellow,line width=.65pt] ($(t.south west)+(0,-.055)$) -- ++(.62,0);
  \end{tikzpicture}\hspace{1.20em}%
}
\setbeamertemplate{section in head/foot shaded}{%
  {\color{PMBluePale}\insertsectionheadnumber.\,\insertsectionhead\hspace{1.20em}}%
}

\setbeamertemplate{headline}{%
  \leavevmode
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.55ex,dp=.85ex,leftskip=.36cm,rightskip=.36cm]{headline}
    \usebeamerfont{headline}%
    \ifnum\value{framenumber}=1\relax
      \insertshorttitle\hfill
      \ifx\PM@topright\@empty
        \PM@seminar\quad\textbar\quad\insertdate
      \else
        \PM@topright
      \fi
    \else
      \insertsectionnavigationhorizontal{\dimexpr\paperwidth-.72cm\relax}{}{}
    \fi
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.05ex,dp=.60ex,leftskip=.36cm,rightskip=.36cm]{footline}
    \usebeamerfont{footline}%
    \makebox[\dimexpr\paperwidth-.72cm\relax]{%
      \PM@leftfooter\hfill\PM@centerfooter\hfill\insertframenumber\,/\,\inserttotalframenumber}
  \end{beamercolorbox}%
}
% keep @-macros available inside the remainder of this theme

% -----------------------------------------------------------------------------
% Frame title
% -----------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vspace{.28em}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=.55cm,rightskip=.55cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\par
    \ifx\insertframesubtitle\empty\else
      \vspace{.12em}{\usebeamerfont{framesubtitle}\color{PMGray}\insertframesubtitle\par}
    \fi
    \vspace{.12em}{\color{PMYellow}\rule{.46cm}{1.05pt}}%
  \end{beamercolorbox}%
  \vspace{.18em}%
}

% -----------------------------------------------------------------------------
% Title page -- faithful to the supplied visual target
% -----------------------------------------------------------------------------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Pale cafe artwork occupying the left third, fading into the white canvas.
    \node[anchor=south west,inner sep=0pt] at ($(current page.south west)+(0,.25)$) {%
      \includegraphics[width=.365\paperwidth]{\PM@assets cafe_left.png}%
    };

    % Main title block lives in the right two-thirds, not centered on the whole slide.
    \node[anchor=north,text width=.61\paperwidth,align=center,text=PMNavyDeep]
      at ($(current page.north west)+(.675\paperwidth,-1.42cm)$) {%
        {\usebeamerfont{title}\inserttitle\par}%
        \vspace{.16cm}%
        {\usebeamerfont{subtitle}\insertsubtitle\par}%
      };

    % Gold rule underneath the subtitle.
    \draw[PMYellow,line width=1.05pt]
      ($(current page.north west)+(.405\paperwidth,-3.88cm)$) --
      ($(current page.north west)+(.900\paperwidth,-3.88cm)$);

    % Author + affiliation.
    \node[anchor=north,text width=.50\paperwidth,align=center,text=PMNavyDeep]
      at ($(current page.north west)+(.675\paperwidth,-4.34cm)$) {%
        {\usebeamerfont{author}\insertauthor\par}%
        \vspace{.10cm}%
        {\usebeamerfont{institute}\insertinstitute\par}%
      };

    % Seminar/date near the lower center, as in the mock-up.
    \node[anchor=north,text width=.50\paperwidth,align=center,text=PMNavyDeep]
      at ($(current page.north west)+(.675\paperwidth,-6.16cm)$) {%
        {\usebeamerfont{date}\PM@seminar\par}%
        \vspace{.06cm}%
        {\usebeamerfont{date}\insertdate\par}%
      };
  \end{tikzpicture}%
  \vphantom{\rule{1pt}{.72\paperheight}}%
}

% -----------------------------------------------------------------------------
% Section divider
% -----------------------------------------------------------------------------
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south east,inner sep=0pt]
      at ($(current page.south east)+(-.10cm,.25cm)$) {\includegraphics[height=.72\paperheight]{\PM@assets menu_corner.png}};

    \node[anchor=north west,text=PMYellow,font=\usebeamerfont{section title}]
      at ($(current page.north west)+(.72cm,-1.40cm)$) {\insertsectionnumber.};
    \node[anchor=north west,text=PMNavyDeep,font=\usebeamerfont{section title}]
      at ($(current page.north west)+(.72cm,-2.22cm)$) {\insertsectionhead};
    \draw[PMYellow,line width=1.05pt]
      ($(current page.north west)+(.72cm,-3.22cm)$) -- ++(4.45cm,0);
    \node[anchor=north west,text=PMNavyDeep,font=\fontsize{7.2}{9}\selectfont\sffamily]
      at ($(current page.north west)+(.72cm,-3.55cm)$) {\PM@sectiontagline};
  \end{tikzpicture}%
  \vphantom{\rule{1pt}{.72\paperheight}}%
}

\ifPMsectionpages
  \AtBeginSection[]{%
    \begin{frame}
      \sectionpage
    \end{frame}%
  }
\fi

% -----------------------------------------------------------------------------
% Lists and blocks
% -----------------------------------------------------------------------------
\setbeamertemplate{itemize item}{%
  \raisebox{.15ex}{\tikz\fill[PMYellow] (0,0) circle (1.9pt);}%
}
\setbeamertemplate{itemize subitem}{%
  \raisebox{.15ex}{\tikz\fill[PMBlue] (0,0) circle (1.35pt);}%
}
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=(n.base)]\node[circle,fill=PMYellow,text=PMNavyDeep,inner sep=1.8pt,font=\scriptsize\bfseries] (n) {\insertenumlabel};%
}
\setbeamertemplate{blocks}[rounded][shadow=false]

% A soft block with the same restrained yellow header seen in the mock-up.
\newenvironment{PMpanel}[1]{%
  \begin{beamercolorbox}[wd=\linewidth,rounded=true,sep=.46em]{block title}%
    \usebeamerfont{block title}#1
  \end{beamercolorbox}%
  \vspace{.12cm}
  \begin{beamercolorbox}[wd=\linewidth,sep=.20em]{block body}%
}{%
  \end{beamercolorbox}%
}

\newenvironment{PMtakeaway}{%
  \begin{beamercolorbox}[wd=\linewidth,rounded=true,sep=.60em]{block title}%
  \color{PMNavyDeep}\bfseries Takeaway.\normalfont\color{PMInk}\ }{\end{beamercolorbox}}

\newcommand{\PMhighlight}[1]{\textcolor{PMYellow}{\bfseries #1}}
\newcommand{\PMthinrule}{\par\vspace{.18em}{\color{PMYellow}\rule{.46cm}{1.05pt}}\vspace{.25em}\par}

% Table-rule helpers for users who do not load booktabs.
\newcommand{\PMtoprule}{\arrayrulecolor{PMBlue}\hline\arrayrulecolor{black}}
\newcommand{\PMmidrule}{\arrayrulecolor{PMBluePale}\hline\arrayrulecolor{black}}
\newcommand{\PMbottomrule}{\arrayrulecolor{PMBlue}\hline\arrayrulecolor{black}}

\makeatother
\mode<all>
