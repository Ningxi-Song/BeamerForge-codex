% Blue Yellow / PoliticsMenu -- graphic poster edition.
% Compile twice with pdfLaTeX. Artwork is drawn entirely in TikZ.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemePoliticsMenu}[2026/10/22 v3.0 Blue Yellow poster edition]
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{tgheros}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{colortbl}
\usetikzlibrary{calc}
\geometry{paperwidth=28.444cm,paperheight=16cm}
\renewcommand{\familydefault}{\sfdefault}
\usefonttheme{professionalfonts}
\newif\ifPMsectionpages
\PMsectionpagestrue
\DeclareOption{nosectionpages}{\PMsectionpagesfalse}
\DeclareOption{sectionpages}{\PMsectionpagestrue}
\ProcessOptions\relax
\definecolor{PMNavy}{HTML}{173BD1}
\definecolor{PMNavyDeep}{HTML}{17213B}
\definecolor{PMBlue}{HTML}{173BD1}
\definecolor{PMBlueMid}{HTML}{6C80BF}
\definecolor{PMBluePale}{HTML}{EAF0FF}
\definecolor{PMYellow}{HTML}{FFD43B}
\definecolor{PMYellowSoft}{HTML}{FFE88C}
\definecolor{PMYellowPale}{HTML}{FFF5CA}
\definecolor{PMInk}{HTML}{17213B}
\definecolor{PMGray}{HTML}{647089}
\definecolor{PMFooter}{HTML}{D9DEEA}
\definecolor{PMWhite}{HTML}{FFFFFF}
\setbeamercolor{normal text}{fg=PMInk,bg=white}
\setbeamercolor{structure}{fg=PMBlue}
\setbeamercolor{frametitle}{fg=PMInk,bg=white}
\setbeamercolor{alerted text}{fg=PMBlue}
\setbeamercolor{block title}{fg=PMBlue,bg=white}
\setbeamercolor{block body}{fg=PMInk,bg=white}
\setbeamercolor{PMtakeaway}{fg=PMInk,bg=PMYellowPale}
\setbeamerfont{normal text}{family=\sffamily,size=\fontsize{18}{25}\selectfont}
\setbeamerfont{frametitle}{family=\sffamily,series=\bfseries,size=\fontsize{30}{35}\selectfont}
\setbeamerfont{title}{family=\sffamily,series=\bfseries,size=\fontsize{56}{58}\selectfont}
\setbeamerfont{subtitle}{family=\sffamily,series=\mdseries,size=\fontsize{19}{26}\selectfont}
\setbeamerfont{block title}{series=\bfseries,size=\fontsize{18}{24}\selectfont}
\setbeamerfont{block body}{size=\fontsize{18}{25}\selectfont}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{18}{25}\selectfont}
\setbeamersize{text margin left=1.5cm,text margin right=1.5cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{itemize item}{\raisebox{0.2ex}{\color{PMBlue}\rule{6pt}{6pt}}}
\setbeamertemplate{enumerate item}{\color{PMBlue}\bfseries\insertenumlabel.}
\AtBeginDocument{\usebeamerfont{normal text}}
\newcommand{\PM@seminar}{Economics Research Seminar}
\newcommand{\PMseminar}[1]{\renewcommand{\PM@seminar}{#1}}
\newcommand{\PM@topright}{}
\newcommand{\PMtopright}[1]{\renewcommand{\PM@topright}{#1}}
\newcommand{\PM@leftfooter}{\insertshortinstitute}
\newcommand{\PMleftfooter}[1]{\renewcommand{\PM@leftfooter}{#1}}
\newcommand{\PM@centerfooter}{\insertshorttitle}
\newcommand{\PMcenterfooter}[1]{\renewcommand{\PM@centerfooter}{#1}}
\newcommand{\PM@assets}{assets/}
\newcommand{\PMassetpath}[1]{\renewcommand{\PM@assets}{#1}} % Compatibility; no artwork dependency.
\newcommand{\PM@sectiontagline}{IDENTITY / CHOICE / EVERYDAY LIFE}
\newcommand{\PMsectiontagline}[1]{\renewcommand{\PM@sectiontagline}{#1}}
\newcommand{\PMlabel}[1]{{\fontsize{11}{14}\selectfont\bfseries\MakeUppercase{#1}}}
\newcommand{\PMnote}[1]{\par\vspace{0.35cm}{\fontsize{11}{15}\selectfont\color{PMGray}#1\par}}
\newcommand{\PMheading}[1]{{\color{PMBlue}\bfseries #1\par}\vspace{0.35cm}}
\setbeamertemplate{frametitle}{%
  \vspace{0.6cm}
  {\color{PMBlue}\PMlabel{\insertsectionhead}}\par\vspace{0.3cm}
  \usebeamerfont{frametitle}\insertframetitle\par\vspace{0.25cm}
  {\color{PMYellow}\rule{1.3cm}{4pt}}\par\vspace{0.2cm}
}
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.65cm,dp=0.3cm,leftskip=1.5cm,rightskip=1.5cm]{normal text}
    {\fontsize{10}{12}\selectfont\color{PMGray}\PM@leftfooter\hfill\PM@centerfooter\hfill
    \color{PMBlue}\bfseries\insertframenumber\ /\ \inserttotalframenumber}
  \end{beamercolorbox}
}
% A plate, fork, and knife reduced to print-like geometry.
\newcommand{\PMplate}{%
  \begin{scope}[shift={(21.4,-7.6)}]
    \fill[PMYellow] (0,0) circle (3.7cm);
    \draw[PMBlue,line width=2pt] (0,0) circle (2.65cm);
    \draw[PMBlue,line width=1pt] (0,0) circle (2.38cm);
    \draw[white,line width=7pt,line cap=round] (-4.65,-2.9) -- (-4.65,1.1);
    \draw[white,line width=4pt,line cap=round] (-5.05,2.8) -- (-5.05,1.4) -- (-4.25,1.4) -- (-4.25,2.8);
    \draw[white,line width=4pt,line cap=round] (-4.65,2.8) -- (-4.65,1.4);
    \fill[white] (4.5,2.9) -- (4.5,-2.9) -- (4.85,-2.9) -- (4.85,0.5)
      .. controls (5.35,1.3) and (5.15,2.5) .. (4.5,2.9);
  \end{scope}
}
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[PMBlue] (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={(current page.north west)}]
      \node[anchor=north west,text=PMYellow] at (1.5,-1.1) {\PMlabel{\PM@seminar}};
      \node[anchor=north west,text=white,text width=13.4cm,align=left,inner sep=0pt]
        at (1.5,-3.4) {\usebeamerfont{title}\inserttitle};
      \node[anchor=north west,text=white,text width=13.4cm,align=left,inner sep=0pt]
        at (1.5,-8.8) {\usebeamerfont{subtitle}\insertsubtitle};
      \node[anchor=south west,text=white,text width=13.4cm,align=left,inner sep=0pt]
        at (1.5,-14.5) {{\bfseries\insertauthor}\par\vspace{0.25cm}{\fontsize{12}{17}\selectfont\insertinstitute\par\insertdate}};
      \node[anchor=north east,text=white,font=\fontsize{10}{13}\selectfont] at (26.9,-1.1) {\PM@topright};
      \PMplate
      \node[text=PMYellow] at (21.4,-13) {\PMlabel{\PM@sectiontagline}};
    \end{scope}
  \end{tikzpicture}
}
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[PMYellow] (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={(current page.north west)}]
      \node[anchor=north west,text=PMBlue] at (1.5,-1.1) {\PMlabel{\insertshorttitle\ / \insertsectionhead}};
      \node[anchor=north east,text=PMBlue,font=\bfseries\fontsize{150}{150}\selectfont,inner sep=0pt]
        at (26.3,-2.5) {\ifnum\insertsectionnumber<10 0\fi\insertsectionnumber};
      \node[anchor=west,text=PMBlue,text width=18cm,align=left,inner sep=0pt,font=\bfseries\fontsize{44}{48}\selectfont]
        at (1.5,-8) {\insertsectionhead};
      \fill[PMBlue] (1.5,-11.7) rectangle (26.9,-11.85);
      \node[anchor=north west,text=PMBlue] at (1.5,-12.6) {\PMlabel{\PM@sectiontagline}};
      \node[anchor=north east,text=PMBlue] at (26.9,-12.6) {\PMlabel{\insertframenumber\ /\ \inserttotalframenumber}};
    \end{scope}
  \end{tikzpicture}
}
\ifPMsectionpages
  \AtBeginSection[]{\begin{frame}[plain]\sectionpage\end{frame}}
\fi
\newenvironment{PMpanel}[1]{\PMheading{#1}}{\par}
\newenvironment{PMtakeaway}{%
  \begin{beamercolorbox}[wd=\linewidth,sep=0.45cm]{PMtakeaway}\usebeamerfont{normal text}
}{\end{beamercolorbox}}
\newcommand{\PMhighlight}[1]{\textcolor{PMBlue}{\bfseries #1}}
\newcommand{\PMthinrule}{\par{\color{PMYellow}\rule{1.3cm}{4pt}}\par}
\newcommand{\PMtoprule}{\arrayrulecolor{PMBlue}\hline\arrayrulecolor{black}}
\newcommand{\PMmidrule}{\arrayrulecolor{PMFooter}\hline\arrayrulecolor{black}}
\newcommand{\PMbottomrule}{\arrayrulecolor{PMBlue}\hline\arrayrulecolor{black}}
\mode<all>
