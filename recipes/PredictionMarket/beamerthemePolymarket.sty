\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemePolymarket}[2026/10/22 Polymarket editorial theme]
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{booktabs,array,colortbl,textcomp,fontspec,anyfontsize}
\usetikzlibrary{calc,positioning}
% A deliberately small, projection-safe palette.
\definecolor{pmNavy}{HTML}{152C40}
\definecolor{pmBody}{HTML}{24394A}
\definecolor{pmBlue}{HTML}{2856D8}
\definecolor{pmBlueBright}{HTML}{2856D8}
\definecolor{pmBlueDeep}{HTML}{1E3F9C}
\definecolor{pmCyan}{HTML}{187C80}
\definecolor{pmViolet}{HTML}{2856D8}
\definecolor{pmGrey}{HTML}{586A78}
\definecolor{pmBG}{HTML}{FAFAF7}
\definecolor{pmPanel}{HTML}{EEF2F7}
\definecolor{pmLine}{HTML}{D6DEE3}
\definecolor{pmGreen}{HTML}{13775D}
\definecolor{pmRed}{HTML}{B9454E}
\definecolor{pmLightBlue}{HTML}{657C9D}
\setbeamercolor{normal text}{fg=pmBody,bg=pmBG}
\setbeamercolor{background canvas}{bg=pmBG}
\setbeamercolor{structure}{fg=pmBlue}
\setbeamercolor{title}{fg=pmNavy}
\setbeamercolor{frametitle}{fg=pmNavy}
\setbeamercolor{itemize item}{fg=pmBlue}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{frametitle}{}
\setbeamersize{text margin left=1.35cm,text margin right=1.35cm}
\usefonttheme{professionalfonts}
\IfFontExistsTF{Segoe UI}{%
  \setsansfont{Segoe UI}[BoldFont={Segoe UI Semibold},ItalicFont={Segoe UI Italic},BoldItalicFont={Segoe UI Bold Italic}]
}{\setsansfont{TeX Gyre Heros}}
\IfFontExistsTF{TeX Gyre Pagella}{\newfontfamily\pmdisplay{TeX Gyre Pagella}}{\newcommand{\pmdisplay}{\rmfamily}}
\renewcommand{\familydefault}{\sfdefault}
% Beamer lists have their own font settings; setting normal text alone is insufficient.
\setbeamerfont{normal text}{size=\fontsize{20}{27}}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{20}{27}}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{16}{22}}
\setbeamerfont{pmhead}{size=\fontsize{10}{13},series=\bfseries}
\setbeamerfont{pmnote}{size=\fontsize{15}{20}}
\setbeamertemplate{itemize item}{\raisebox{0.2ex}{\textcolor{pmBlue}{\rule{0.23em}{0.23em}}}}
\setbeamertemplate{itemize subitem}{\textcolor{pmGrey}{\textendash}}
\setlength{\leftmargini}{1.1em}
\setlength{\leftmarginii}{1.4em}
\AtBeginEnvironment{itemize}{\setlength{\itemsep}{10pt}\setlength{\parsep}{0pt}\setlength{\parskip}{0pt}}
\renewcommand{\arraystretch}{1.04}
\setlength{\tabcolsep}{10pt}
\arrayrulecolor{pmLine}
\newcommand{\arr}{\textcolor{pmBlue}{$\rightarrow$}}
\newcommand{\pmnote}[1]{\par\vspace{4pt}{\color{pmGrey}\fontsize{15}{20}\selectfont #1\par}}
% Header and footer share the same safe-area grid as the content.
% The second argument is retained for source compatibility; folios are automatic.
\newcommand{\pmheader}[2]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=west,inner sep=0pt,text=pmBlue,font=\fontsize{10}{13}\selectfont\bfseries]
      at ([xshift=1.35cm,yshift=-0.72cm]current page.north west) {POLYMARKET / RESEARCH};
    \node[anchor=east,inner sep=0pt,text=pmGrey,font=\fontsize{10}{13}\selectfont]
      at ([xshift=-1.35cm,yshift=-0.72cm]current page.north east) {#1};
    \draw[pmLine,line width=0.5pt]
      ([xshift=1.35cm,yshift=0.92cm]current page.south west)--([xshift=-1.35cm,yshift=0.92cm]current page.south east);
    \node[anchor=west,inner sep=0pt,text=pmGrey,font=\fontsize{9}{12}\selectfont]
      at ([xshift=1.35cm,yshift=0.52cm]current page.south west) {HKU BUSINESS SCHOOL\enspace /\enspace PREDICTION MARKETS};
    \node[anchor=east,inner sep=0pt,text=pmNavy,font=\fontsize{10}{12}\selectfont]
      at ([xshift=-1.35cm,yshift=0.52cm]current page.south east) {\insertframenumber\enspace /\enspace\inserttotalframenumber};
  \end{tikzpicture}%
  \vspace*{1.12cm}%
}
\newcommand{\pmtitle}[1]{\par%
  {\color{pmNavy}\fontsize{30}{36}\selectfont\bfseries #1\par}%
  \vspace{0.26cm}{\color{pmBlue}\rule{1.15cm}{1.6pt}}\par\vspace{0.10cm}%
}
% Flat tonal panels: readable title, no high-saturation banner.
\newtcolorbox{pmcallout}[1][]{enhanced,
  colback=pmPanel,colframe=pmBlue,coltext=pmBody,
  boxrule=0pt,leftrule=2pt,sharp corners,
  left=12pt,right=12pt,top=9pt,bottom=9pt,
  colbacktitle=pmPanel,coltitle=pmBlue,
  fonttitle=\fontsize{14}{18}\selectfont\bfseries,
  fontupper=\fontsize{20}{27}\selectfont\raggedright,
  title=#1,titlerule=0pt,toptitle=8pt,bottomtitle=0pt,
  before skip=12pt,after skip=8pt
}
\newtcolorbox{pmkey}[1][]{enhanced,
  colback=pmPanel,coltext=pmNavy,colframe=pmLine,
  boxrule=0.5pt,sharp corners,left=12pt,right=12pt,top=11pt,bottom=11pt,
  fontupper=\fontsize{20}{27}\selectfont\bfseries,
  before skip=8pt,after skip=8pt,#1
}
% An editorial cover with a typographic title and an abstract probability field.
\newcommand{\pmcover}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[pmPanel] ([xshift=23.9cm]current page.north west) rectangle (current page.south east);
    \node[anchor=west,inner sep=0pt,text=pmBlue,font=\fontsize{11}{14}\selectfont\bfseries]
      at ([xshift=1.35cm,yshift=-1.25cm]current page.north west) {POLYMARKET / RESEARCH};
    \node[anchor=north west,inner sep=0pt,text=pmNavy,text width=21cm,align=left,font=\pmdisplay\fontsize{44}{51}\selectfont]
      at ([xshift=1.35cm,yshift=-5.1cm]current page.north west) {\inserttitle};
    \draw[pmBlue,line width=2pt] ([xshift=1.35cm,yshift=-11.5cm]current page.north west)--++(1.4cm,0);
    \node[anchor=north west,inner sep=0pt,text=pmGrey,text width=20cm,align=left,font=\fontsize{20}{27}\selectfont]
      at ([xshift=1.35cm,yshift=-12.2cm]current page.north west) {\insertsubtitle};
    \node[anchor=west,inner sep=0pt,text=pmNavy,font=\fontsize{17}{23}\selectfont\bfseries]
      at ([xshift=1.35cm,yshift=2.1cm]current page.south west) {\insertauthor};
    \node[anchor=west,inner sep=0pt,text=pmGrey,font=\fontsize{12}{16}\selectfont]
      at ([xshift=1.35cm,yshift=1.3cm]current page.south west) {\insertinstitute};
    % The geometry is decorative, not an empirical chart.
    \begin{scope}[shift={([xshift=24.8cm,yshift=-10.6cm]current page.north west)}]
      \foreach \y in {-3,-1.5,0,1.5,3} {\draw[pmLine,line width=0.4pt] (0,\y)--(7.6,\y);}
      \draw[pmBlue!20,line width=1pt] (0,-2.6)..controls(2,-2.1)and(2.4,1.5)..(4.1,1.0)..controls(5.5,0.5)and(6,2.4)..(7.6,3.4);
      \draw[pmBlue,line width=2.2pt] (0,-2.7)..controls(1.8,-2.7)and(2.8,-1.5)..(3.8,0)..controls(5.1,1.8)and(6,2.7)..(7.6,2.7);
      \fill[pmBG] (3.8,0) circle (0.19cm);
      \draw[pmBlue,line width=1.6pt] (3.8,0) circle (0.19cm);
      \node[anchor=west,text=pmBlue,font=\fontsize{11}{15}\selectfont\bfseries] at (0,4.6) {INFORMATION INTO PRICES};
      \node[anchor=west,text=pmGrey,font=\fontsize{11}{15}\selectfont] at (0,-4.7) {EVENTS\quad /\quad BELIEFS\quad /\quad MARKETS};
    \end{scope}
    \node[anchor=east,inner sep=0pt,text=pmGrey,font=\fontsize{10}{13}\selectfont]
      at ([xshift=-1.35cm,yshift=1.3cm]current page.south east) {1\enspace /\enspace\inserttotalframenumber};
  \end{tikzpicture}%
}
\newenvironment{pmbody}[1][13.6cm]{%
  \par\noindent\begin{minipage}[t][#1][s]{\textwidth}%
  \fontsize{20}{27}\selectfont\raggedright\vspace{0pt}\vfill
}{\par\vfill\vspace{0pt}\end{minipage}\par}
\newcommand{\pmspreaditems}{\setlength{\itemsep}{12pt plus 1fill}}
